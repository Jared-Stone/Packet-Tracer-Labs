Youtube Video Lab

Devices
2x Routers: R1, R2
2x Multi-Layer Switches: DSW1, DSW2
2x Layer 2 Switches: ASW1, ASW2
7x PCs
1x Server: DHCP_SVR

VLANs
VLAN 10 - STAFF
IP Address: 192.168.10.0/24
VLAN 20 - ADMIN
IP Address 192.168.20.0/24
VLAN 30 - IT
IP Address: 192.168.30.0/24
VLAN 99 - Management
IP Address: 10.0.99.0/24

Static Routes and Reservations
R1 - DSW1: 10.0.1.0/30
R1 - ISP: 203.0.113.2/30
R2 - DSW2: 10.0.2.0/30
R2 - ISP: 203.0.113.6/30
DSW1 - DSW2: 10.0.3.0/30
DHCP_SVR: 10.0.99.10

## R1 ##

en
conf t
hostname R1
username jstone priv 15 secret admin
service password-encryption
enable secret admin
lldp run
line vty 0 4
transport input ssh
login local
exit
line console 0 
login local
access-list 10 permit 10.0.0.0 0.0.255.255
access-list 10 permit 192.168.0.0 0.0.255.255

int g0/0/0
description R1-DSW1
ip address 10.0.1.1 255.255.255.252
ip nat inside
no shutdown
int g0/0/1
description R1-ISP
ip address 203.0.113.2 255.255.255.252
ip nat outside
no shutdown
int loopback 0
ip address 1.1.1.1 255.255.255.255
no shutdown
exit

ip route 0.0.0.0 0.0.0.0 203.0.113.1
ip nat inside source list 10 interface g0/0/1 overload

router ospf 1
router-id 1.1.1.1
network 10.0.0.0 0.0.255.255 area 0
network 192.168.0.0 0.0.255.255 area 0
default-information originate
end 
write

## DSW1 ##

en
conf t
hostname DSW1
username jstone priv 15 secret admin
service password-encryption
enable secret admin
lldp run
line vty 0 4
transport input ssh
login local
exit
line console 0 
login local
exit
spanning-tree mode rapid-PVST
ip routing

vlan 10
name STAFF
vlan 20
name ADMIN
vlan 30
name IT
vlan 99
name MANAGEMENT
exit

int port-channel 1
description DSW1-DSW2
no switchport
ip address 10.0.3.1 255.255.255.252
no shutdown


int g0/1
description DSW1-R!
no switchport
ip address 10.0.1.2 255.255.255.252
int range f0/1-3
description DSW1-DSW2
no switchport
channel-group 1 mode active
int f0/4
description DSW1-ASW1
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,99
int f0/5
description DSW1-ASW2
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk native vlan 999
switchport trunk allowed vlan 10,20,30,99
int vlan 10
description STAFF
ip address 192.168.10.2 255.255.255.0
standby 1 ip 192.168.10.1
standby 1 priority 110
standby 1 preempt 
ip helper-address 10.0.99.10
int vlan 20
description ADMIN
ip address 192.168.20.2 255.255.255.0
standby 2 ip 192.168.20.1
standby 2 priority 110
standby 2 preempt 
ip helper-address 10.0.99.10
int vlan 30
description IT
ip address 192.168.30.2 255.255.255.0
standby 3 ip 192.168.30.1
standby 3 priority 100
standby 3 preempt 
ip helper-address 10.0.99.10
int vlan 99
description MANAGEMENT
ip address 10.0.99.2 255.255.255.0
standby 4 ip 10.0.99.1
standby 4 priority 100
standby 4 preempt 
ip helper-address 10.0.99.10
int loopback 0
ip address 3.3.3.3 255.255.255.255
exit

router ospf 1
router-id 3.3.3.3
network 10.0.0.0 0.0.255.255 area 0
network 192.168.0.0 0.0.255.255 area 0
end
write

